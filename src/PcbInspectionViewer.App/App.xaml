<Application x:Class="PcbInspectionViewer.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:PcbInspectionViewer.App.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/CalmLight.xaml" />
            </ResourceDictionary.MergedDictionaries>
        <converters:OnlineToStatusBrushConverter x:Key="OnlineToStatusBrushConverter" />
        <converters:VerdictToBrushConverter x:Key="VerdictToBrushConverter" />
        <converters:VerdictToDisplayLabelConverter x:Key="VerdictToDisplayLabelConverter" />
        <converters:BatchStatusToBrushConverter x:Key="BatchStatusToBrushConverter" />
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        <converters:NullOrEmptyToVisibilityConverter x:Key="NullOrEmptyToVisibilityConverter" />
        <converters:IpcClauseShortConverter x:Key="IpcClauseShortConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
