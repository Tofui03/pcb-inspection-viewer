<Window x:Class="PcbInspectionViewer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PcbInspectionViewer.App.Controls"
        Title="PCB Inspection Viewer"
        Width="1360"
        Height="860"
        MinWidth="1080"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.Paper}"
        PreviewKeyDown="OnWindowPreviewKeyDown">
    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding Inspect.InspectCommand}" />
        <KeyBinding Key="Escape" Command="{Binding Inspect.CancelInspectCommand}" />
        <KeyBinding Key="F2" Command="{Binding OpenBatchTabCommand}" />
        <KeyBinding Key="F3" Command="{Binding OpenHistoryTabCommand}" />
        <KeyBinding Key="F7" Command="{Binding OpenSettingsTabCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="12,8" Visibility="{Binding HasAlarm, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{StaticResource Brush.Alarm}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding AlarmIsAmber}" Value="True">
                            <Setter Property="Background" Value="{StaticResource Brush.Amber}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding AlarmText}" FontSize="13" FontWeight="Bold" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource Brush.AlarmInk}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding AlarmIsAmber}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Brush.AmberInk}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>

        <TabControl Grid.Row="1"
                    SelectedIndex="{Binding SelectedTabIndex}"
                    Margin="12,12,12,8"
                    Background="White"
                    BorderBrush="#CBD5E1">
            <!-- Screen 1: Single Inspect (F1) -->
            <TabItem Header="Single Inspect">
                <Grid Margin="16" DataContext="{Binding Inspect}">
                    <Grid Visibility="{Binding ShowWorkspace, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="340" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Margin="0,0,24,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Content="Test"
                                        Command="{Binding SelectLayerCommand}"
                                        CommandParameter="Test"
                                        Style="{StaticResource QuietButton}" />
                                <Button Content="Template"
                                        Command="{Binding SelectLayerCommand}"
                                        CommandParameter="Template"
                                        Style="{StaticResource QuietButton}" />
                                <Button Content="Diff"
                                        Command="{Binding SelectLayerCommand}"
                                        CommandParameter="Diff"
                                        Style="{StaticResource QuietButton}" />
                                <CheckBox Content="Boxes"
                                          IsChecked="{Binding ShowBoundingBoxes}"
                                          VerticalAlignment="Center"
                                          Margin="12,0,0,0"
                                          Foreground="{StaticResource Brush.Muted}" />
                                <Button Content="100%"
                                        Command="{Binding ResetZoomAndPanCommand}"
                                        Style="{StaticResource QuietButton}" />
                            </StackPanel>
                            <Border Grid.Row="1"
                                    Background="{StaticResource Brush.Canvas}"
                                    CornerRadius="8"
                                    AllowDrop="True"
                                    DragOver="OnImageDropZoneDragOver"
                                    Drop="OnTestImageDrop">
                                <controls:DefectOverlayCanvas ImageDataUri="{Binding ActiveImageDataUri}"
                                                              Detections="{Binding Detections}"
                                                              ShowBoundingBoxes="{Binding ShowBoundingBoxes}"
                                                              ZoomFactor="{Binding ZoomFactor}"
                                                              PanX="{Binding PanX}"
                                                              PanY="{Binding PanY}"
                                                              SelectDefectCommand="{Binding SelectDefectCommand}" />
                            </Border>
                        </Grid>

                        <DockPanel Grid.Column="1">
                            <Button DockPanel.Dock="Bottom"
                                    Content="{Binding PrimaryActionLabel}"
                                    Click="OnPrimaryClick"
                                    Style="{StaticResource PrimaryButton}"
                                    Margin="0,16,0,0" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <ProgressBar Height="2"
                                                 IsIndeterminate="True"
                                                 BorderThickness="0"
                                                 Foreground="{StaticResource Brush.Ink}"
                                                 Background="{StaticResource Brush.Line}"
                                                 Margin="0,0,0,12"
                                                 Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <TextBlock Text="{Binding VerdictText}"
                                               FontSize="48"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,12">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource Brush.Scrap}" />
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding HasResult}" Value="True" />
                                                            <Condition Binding="{Binding HasError}" Value="False" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </MultiDataTrigger>
                                                    <DataTrigger Binding="{Binding VerdictText}" Value="PASS">
                                                        <Setter Property="Foreground" Value="{StaticResource Brush.Pass}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding VerdictText}" Value="REWORK">
                                                        <Setter Property="Foreground" Value="{StaticResource Brush.Rework}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <StackPanel Orientation="Horizontal"
                                                Margin="0,0,0,12"
                                                Visibility="{Binding ShowFileNames, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="{Binding TemplateFileName}"
                                                   FontSize="12"
                                                   Foreground="{StaticResource Brush.Muted}" />
                                        <TextBlock Text=" · "
                                                   FontSize="12"
                                                   Foreground="{StaticResource Brush.Muted}" />
                                        <TextBlock Text="{Binding TestFileName}"
                                                   FontSize="12"
                                                   Foreground="{StaticResource Brush.Muted}" />
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding AlignedDefects}"
                                                  Visibility="{Binding HasResult, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource RowButton}"
                                                        Command="{Binding DataContext.SelectDefectCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding Index}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="88" />
                                                            <ColumnDefinition Width="44" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Detection.DefectClass}"
                                                                   FontSize="14"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource Brush.Ink}"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding Detection.Confidence, StringFormat={}{0:0.00}}"
                                                                   FontSize="14"
                                                                   Foreground="{StaticResource Brush.Muted}"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="2"
                                                                   Text="{Binding Decision.IpcStandardClause, Converter={StaticResource IpcClauseShortConverter}}"
                                                                   FontSize="12"
                                                                   Foreground="{StaticResource Brush.Muted}"
                                                                   HorizontalAlignment="Right"
                                                                   VerticalAlignment="Center" />
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{Binding SelectedDefectText}"
                                               FontSize="12"
                                               Foreground="{StaticResource Brush.Ink}"
                                               TextWrapping="Wrap"
                                               Margin="0,12,0,0"
                                               Visibility="{Binding ShowDefectDetail, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </Grid>

                    <Button Content="{Binding PrimaryActionLabel}"
                            Click="OnPrimaryClick"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowWorkspace}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </TabItem>

            <!-- Screen 2: Batch Inspect (F2) -->
            <TabItem Header="2. Batch Inspect (F2)">
                <Grid Margin="16" DataContext="{Binding Batch}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Top Config & Action Bar -->
                    <Border Grid.Row="0"
                            Background="#F8FAFC"
                            BorderBrush="#CBD5E1"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16"
                            Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Folder Selection -->
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="Target Boards Folder" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding FolderPath, UpdateSourceTrigger=PropertyChanged}" Padding="6,5" />
                                    <Button Grid.Column="1" Content="Browse..." Click="OnBrowseBatchFolderClick" Padding="10,5" Margin="6,0,0,0" />
                                </Grid>
                                <CheckBox Content="DeepPCB auto-pairing (&lt;id&gt;_test ↔ &lt;id&gt;_temp)"
                                          IsChecked="{Binding UseDeepPcbAutoPairing}"
                                          FontWeight="SemiBold"
                                          Margin="0,6,0,0" />
                            </StackPanel>

                            <!-- Global Template (Disabled if DeepPCB auto-pairing) -->
                            <StackPanel Grid.Column="1" Margin="0,0,12,0" IsEnabled="{Binding UseDeepPcbAutoPairing, Converter={StaticResource InverseBooleanConverter}}">
                                <TextBlock Text="Global Golden Template (Single-template mode)" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding GlobalTemplatePath, UpdateSourceTrigger=PropertyChanged}" Padding="6,5" />
                                    <Button Grid.Column="1" Content="Browse..." Click="OnBrowseBatchTemplateClick" Padding="10,5" Margin="6,0,0,0" />
                                </Grid>
                            </StackPanel>

                            <!-- Options -->
                            <StackPanel Grid.Column="2" Margin="0,0,12,0">
                                <TextBlock Text="Batch ID / IPC / Concurrency" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="40" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding BatchId, UpdateSourceTrigger=PropertyChanged}" Padding="6,5" Margin="0,0,4,0" ToolTip="Batch Identifier" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding AllowedIpcClasses}" SelectedItem="{Binding IpcClass}" Padding="4,4" Margin="0,0,4,0" ToolTip="IPC-A-600 Class" />
                                    <TextBox Grid.Column="2" Text="{Binding Concurrency, UpdateSourceTrigger=PropertyChanged}" Padding="6,5" ToolTip="Concurrency (1–8)" />
                                </Grid>
                                <CheckBox Content="Colorize PCB visuals" IsChecked="{Binding ColorizePcb}" Margin="0,6,0,0" />
                            </StackPanel>

                            <!-- Actions -->
                            <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                <Button Content="Start Batch (F2)"
                                        Command="{Binding StartBatchCommand}"
                                        Background="#2563EB"
                                        Foreground="White"
                                        FontWeight="Bold"
                                        Padding="16,8"
                                        Margin="0,0,0,6" />
                                <Button Content="Cancel Batch"
                                        Command="{Binding CancelBatchCommand}"
                                        Padding="16,6" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Progress & KPI Metrics Card -->
                    <Border Grid.Row="1"
                            Background="White"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16,12"
                            Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding StatusMessage}" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Progress: " FontWeight="SemiBold" Foreground="#64748B" />
                                    <TextBlock Text="{Binding CompletedCount}" FontWeight="Bold" Foreground="#10B981" />
                                    <TextBlock Text=" passed/done, " Foreground="#64748B" />
                                    <TextBlock Text="{Binding FailedCount}" FontWeight="Bold" Foreground="#EF4444" />
                                    <TextBlock Text=" failed / " Foreground="#64748B" />
                                    <TextBlock Text="{Binding TotalItems}" FontWeight="Bold" Foreground="#0F172A" />
                                    <TextBlock Text=" total · Elapsed: " Foreground="#64748B" Margin="8,0,0,0" />
                                    <TextBlock Text="{Binding ElapsedText}" FontWeight="Bold" Foreground="#0F172A" />
                                    <TextBlock Text=" · ETA: " Foreground="#64748B" Margin="4,0,0,0" />
                                    <TextBlock Text="{Binding EtaText}" FontWeight="Bold" Foreground="#0F172A" />
                                </StackPanel>
                            </Grid>

                            <ProgressBar Grid.Row="1" Value="{Binding PercentComplete}" Height="8" Minimum="0" Maximum="100" />
                        </Grid>
                    </Border>

                    <!-- Batch Items Virtualized Live DataGrid -->
                    <Border Grid.Row="2"
                            BorderBrush="#CBD5E1"
                            BorderThickness="1"
                            CornerRadius="6">
                        <DataGrid ItemsSource="{Binding Items}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserSortColumns="True"
                                  EnableRowVirtualization="True"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#E2E8F0"
                                  RowHeight="32"
                                  Background="White"
                                  BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="50" />
                                <DataGridTextColumn Header="File Name" Binding="{Binding FileName}" Width="240" />
                                <DataGridTemplateColumn Header="Status" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding Status, Converter={StaticResource BatchStatusToBrushConverter}}"
                                                    CornerRadius="4"
                                                    Padding="6,2"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Status}" Foreground="White" FontWeight="Bold" FontSize="11" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Verdict" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding Verdict, Converter={StaticResource VerdictToBrushConverter}}"
                                                    CornerRadius="4"
                                                    Padding="6,2"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding Verdict, Converter={StaticResource NullOrEmptyToVisibilityConverter}}">
                                                <TextBlock Text="{Binding Verdict}" Foreground="White" FontWeight="Bold" FontSize="11" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="# Defects" Binding="{Binding DefectCount}" Width="80" />
                                <DataGridTextColumn Header="Stage-1 Latency" Binding="{Binding Stage1LatencyMs, StringFormat={}{0:F1} ms}" Width="120" />
                                <DataGridTextColumn Header="Notes / Errors" Binding="{Binding ErrorMessage}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Screen 3: History (F3) -->
            <TabItem Header="3. History (F3)">
                <Grid Margin="16" DataContext="{Binding History}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Filter Control Bar -->
                    <Border Grid.Row="0"
                            Background="#F8FAFC"
                            BorderBrush="#CBD5E1"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12,10"
                            Margin="0,0,0,12">
                        <WrapPanel VerticalAlignment="Center">
                            <!-- Verdict filter -->
                            <TextBlock Text="Verdict:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,6,0" />
                            <ComboBox ItemsSource="{Binding AvailableVerdicts}"
                                      SelectedItem="{Binding SelectedVerdict}"
                                      Width="100"
                                      Padding="6,4"
                                      Margin="0,0,16,0" />

                            <!-- Batch filter -->
                            <TextBlock Text="Batch:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,6,0" />
                            <ComboBox ItemsSource="{Binding AvailableBatches}"
                                      SelectedItem="{Binding SelectedBatch}"
                                      Width="140"
                                      Padding="6,4"
                                      Margin="0,0,16,0" />

                            <!-- Date Range filters (Spec Gap 1) -->
                            <TextBlock Text="From:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,6,0" />
                            <DatePicker SelectedDate="{Binding StartDate}" Width="120" Margin="0,0,12,0" />

                            <TextBlock Text="To:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,6,0" />
                            <DatePicker SelectedDate="{Binding EndDate}" Width="120" Margin="0,0,16,0" />

                            <!-- File search -->
                            <TextBlock Text="File:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,6,0" />
                            <TextBox Text="{Binding FileNameSearch, UpdateSourceTrigger=PropertyChanged}"
                                     Width="140"
                                     Padding="6,4"
                                     Margin="0,0,16,0" />

                            <!-- Defect classes multi-select pills -->
                            <TextBlock Text="Defect Classes:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,8,0" />
                            <ItemsControl ItemsSource="{Binding AvailableDefectClasses}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding}"
                                                Command="{Binding DataContext.ToggleDefectClassFilterCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Padding="8,3"
                                                Margin="0,0,6,0"
                                                FontSize="11.5" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Actions -->
                            <Button Content="Search"
                                    Command="{Binding LoadHistoryCommand}"
                                    Background="#2563EB"
                                    Foreground="White"
                                    FontWeight="SemiBold"
                                    Padding="14,5"
                                    Margin="8,0,8,0" />

                            <Button Content="Clear Filters"
                                    Command="{Binding ClearFiltersCommand}"
                                    Padding="10,5"
                                    Margin="0,0,16,0" />

                            <!-- Export buttons (F5) -->
                            <Button Content="Export CSV"
                                    Click="OnExportHistoryCsvClicked"
                                    Background="#059669"
                                    Foreground="White"
                                    FontWeight="SemiBold"
                                    Padding="10,5"
                                    Margin="0,0,8,0" />

                            <Button Content="Export PDF"
                                    Click="OnExportHistoryPdfClicked"
                                    Background="#D97706"
                                    Foreground="White"
                                    FontWeight="SemiBold"
                                    Padding="10,5" />
                        </WrapPanel>
                    </Border>

                    <!-- Virtualized DataGrid -->
                    <Border Grid.Row="1"
                            BorderBrush="#CBD5E1"
                            BorderThickness="1"
                            CornerRadius="6">
                        <DataGrid ItemsSource="{Binding Items}"
                                  SelectedItem="{Binding SelectedItem}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserSortColumns="True"
                                  CanUserResizeColumns="True"
                                  EnableRowVirtualization="True"
                                  EnableColumnVirtualization="True"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  ScrollViewer.IsDeferredScrollingEnabled="True"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#E2E8F0"
                                  RowHeight="34"
                                  Background="White"
                                  BorderThickness="0"
                                  SelectionMode="Single"
                                  MouseDoubleClick="OnHistoryDataGridMouseDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Time (Local)" Binding="{Binding InspectedAtLocal, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Width="150" />
                                <DataGridTextColumn Header="File Name" Binding="{Binding FileName}" Width="160" />
                                <DataGridTextColumn Header="Batch ID" Binding="{Binding BatchId}" Width="120" />
                                <DataGridTemplateColumn Header="Verdict" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding BoardDisposition, Converter={StaticResource VerdictToBrushConverter}}"
                                                    CornerRadius="4"
                                                    Padding="6,2"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding BoardDisposition}"
                                                           Foreground="White"
                                                           FontWeight="Bold"
                                                           FontSize="11" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="# Defects" Binding="{Binding DefectCount}" Width="80" />
                                <DataGridTextColumn Header="Defect Classes" Binding="{Binding DefectClassesSummary}" Width="*" />
                                <DataGridTextColumn Header="Stage-1 Latency" Binding="{Binding Stage1LatencyMs, StringFormat={}{0:F1} ms}" Width="110" />
                                <DataGridTextColumn Header="Round-Trip" Binding="{Binding RoundTripMs, StringFormat={}{0:F1} ms}" Width="100" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- Bottom History Status / Actions -->
                    <DockPanel Grid.Row="2" Margin="0,8,0,0">
                        <Button DockPanel.Dock="Right"
                                Content="Open Data Folder"
                                Click="OnOpenDataFolderClick"
                                Padding="12,5" />
                        <TextBlock Text="{Binding StatusMessage}"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Foreground="#475569" />
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- Screen 3: Dashboard (F4) -->
            <TabItem Header="3. Dashboard (F4)">
                <Grid Margin="16" DataContext="{Binding Dashboard}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Top Bar: Date selection and Refresh -->
                    <Border Grid.Row="0" Background="#F1F5F9" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                        <DockPanel LastChildFill="False">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                <TextBlock Text="Target Day:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#0F172A" />
                                <DatePicker SelectedDate="{Binding SelectedDate, Mode=TwoWay}" Width="140" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <Button Content="Refresh Metrics" Command="{Binding RefreshDashboardCommand}" Padding="12,6" Background="#0284C7" Foreground="White" BorderThickness="0" Cursor="Hand" />
                            </StackPanel>
                            <TextBlock Text="{Binding StatusMessage}" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="#64748B" FontStyle="Italic" />
                        </DockPanel>
                    </Border>

                    <!-- KPI Cards Row -->
                    <UniformGrid Grid.Row="1" Columns="5" Margin="0,0,0,16">
                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="BOARDS INSPECTED" FontSize="11" FontWeight="Bold" Foreground="#64748B" />
                                <TextBlock Text="{Binding TotalInspected}" FontSize="24" FontWeight="Bold" Foreground="#0F172A" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Background="White" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="PASS COUNT" FontSize="11" FontWeight="Bold" Foreground="#15803D" />
                                <TextBlock Text="{Binding PassCount}" FontSize="24" FontWeight="Bold" Foreground="#16A34A" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Background="White" BorderBrush="#FEF08A" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="REWORK REQUIRED" FontSize="11" FontWeight="Bold" Foreground="#B45309" />
                                <TextBlock Text="{Binding ReworkCount}" FontSize="24" FontWeight="Bold" Foreground="#D97706" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Background="White" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="SCRAP" FontSize="11" FontWeight="Bold" Foreground="#B91C1C" />
                                <TextBlock Text="{Binding ScrapCount}" FontSize="24" FontWeight="Bold" Foreground="#DC2626" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Background="White" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="8" Padding="14">
                            <StackPanel>
                                <TextBlock Text="OVERALL YIELD" FontSize="11" FontWeight="Bold" Foreground="#0369A1" />
                                <TextBlock Text="{Binding YieldPercentage, StringFormat={}{0:F1}%}" FontSize="24" FontWeight="Bold" Foreground="#0284C7" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Main Panels: Top Defects & Hourly Throughput -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="380" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: Top Defect Classes & Halted Line Status -->
                        <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,12,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="Top Defect Distribution" FontSize="15" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,12" />
                                    <ItemsControl ItemsSource="{Binding TopDefectClasses}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="0,6,0,6">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="{Binding DefectClass}" FontWeight="SemiBold" Foreground="#334155" />
                                                            <TextBlock Text="{Binding Count, StringFormat={}{0} occurrences}" FontSize="11" Foreground="#64748B" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Text="{Binding Percentage, StringFormat={}{0:F1}%}" FontWeight="Bold" Foreground="#0284C7" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Separator Margin="0,16,0,16" Background="#E2E8F0" />
                                    <TextBlock Text="Quality Guardrail Status" FontSize="15" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,8" />
                                    <TextBlock Text="Halted Batches Count:" FontSize="12" Foreground="#64748B" />
                                    <TextBlock Text="{Binding HaltedBatchesCount}" FontSize="18" FontWeight="Bold" Foreground="#DC2626" Margin="0,2,0,8" />
                                    <TextBlock Text="Halted Batch IDs:" FontSize="12" Foreground="#64748B" />
                                    <TextBlock Text="{Binding HaltedBatchesSummary}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="#334155" />
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <!-- Right: Hourly Throughput Table -->
                        <Border Grid.Column="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16">
                            <DockPanel>
                                <TextBlock Text="Hourly Throughput (24 Hours)" FontSize="15" FontWeight="Bold" Foreground="#0F172A" DockPanel.Dock="Top" Margin="0,0,0,12" />
                                <DataGrid ItemsSource="{Binding HourlyThroughput}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          GridLinesVisibility="Horizontal"
                                          HorizontalGridLinesBrush="#F1F5F9"
                                          BorderThickness="0"
                                          RowHeight="26"
                                          Background="Transparent">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Hour" Binding="{Binding HourLabel}" Width="100" />
                                        <DataGridTextColumn Header="Inspected" Binding="{Binding InspectedCount}" Width="110" />
                                        <DataGridTextColumn Header="Pass" Binding="{Binding PassCount}" Width="110" />
                                        <DataGridTextColumn Header="Rework" Binding="{Binding ReworkCount}" Width="110" />
                                        <DataGridTextColumn Header="Scrap" Binding="{Binding ScrapCount}" Width="110" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- Screen 4: Ask (P2 NL → SQL) -->
            <TabItem Header="4. Ask (NL → SQL)">
                <Grid Margin="16" DataContext="{Binding Ask}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Question Input Card -->
                    <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Natural-Language History Query (Guarded NL → SQL)" FontSize="16" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,6" />
                            <TextBlock Text="Ask questions in plain English or Chinese about past inspections, yield trends, or defects. The query runs exclusively against read-only views under strict SqlGuard security."
                                       FontSize="12" Foreground="#64748B" Margin="0,0,0,12" TextWrapping="Wrap" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding Question, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="10,8"
                                         FontSize="13"
                                         Background="White"
                                         BorderBrush="#CBD5E1"
                                         Margin="0,0,10,0" />
                                <Button Grid.Column="1"
                                        Content="Generate SQL"
                                        Command="{Binding GenerateSqlCommand}"
                                        Background="#2563EB"
                                        Foreground="White"
                                        FontWeight="SemiBold"
                                        Padding="16,8"
                                        Cursor="Hand" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- SQL Preview & Run Card -->
                    <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <DockPanel LastChildFill="False" Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                    <TextBlock Text="Generated Guarded SQL Preview" FontWeight="Bold" Foreground="#334155" VerticalAlignment="Center" />
                                    <TextBlock Text=" (Auto-run disabled; explicit execution required)" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" Margin="6,0,0,0" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                    <Button Content="Run Query"
                                            Command="{Binding RunQueryCommand}"
                                            Background="#059669"
                                            Foreground="White"
                                            FontWeight="Bold"
                                            Padding="14,5"
                                            Cursor="Hand" />
                                </StackPanel>
                            </DockPanel>

                            <TextBox Text="{Binding GeneratedSql}"
                                     IsReadOnly="True"
                                     FontFamily="Consolas, 'Courier New', monospace"
                                     FontSize="12"
                                     Background="#F1F5F9"
                                     Foreground="#0F172A"
                                     BorderBrush="#CBD5E1"
                                     Padding="10"
                                     Height="65"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" />

                            <TextBlock Text="{Binding Explanation}"
                                       FontSize="12"
                                       FontStyle="Italic"
                                       Foreground="#475569"
                                       Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Results Grid & Status -->
                    <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12">
                        <DockPanel>
                            <Border DockPanel.Dock="Bottom" Background="#F8FAFC" Padding="10,6" Margin="0,8,0,0" CornerRadius="4">
                                <DockPanel LastChildFill="False">
                                    <TextBlock Text="{Binding StatusMessage}" DockPanel.Dock="Left" Foreground="#475569" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding ExecutionTimeMs, StringFormat={}Execution: {0} ms}" DockPanel.Dock="Right" Foreground="#64748B" FontSize="11" VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>

                            <DataGrid ItemsSource="{Binding ResultsTable}"
                                      AutoGenerateColumns="True"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#F1F5F9"
                                      BorderThickness="0"
                                      Background="Transparent" />
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Screen 5: Settings (F7) -->
            <TabItem Header="5. Settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
                    <StackPanel MaxWidth="680" HorizontalAlignment="Left" DataContext="{Binding Settings}">
                        <TextBlock Text="Station &amp; Backend Settings (F7)"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"
                                   Margin="0,0,0,8" />

                        <TextBlock Text="{Binding DataContext.DatabasePathText, RelativeSource={RelativeSource AncestorType=Window}}"
                                   FontSize="12"
                                   Foreground="#64748B"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,4" />
                        <TextBlock Text="{Binding DataContext.LlmProviderStatusText, RelativeSource={RelativeSource AncestorType=Window}}"
                                   FontSize="12"
                                   Foreground="#64748B"
                                   Margin="0,0,0,16" />

                        <!-- API Settings -->
                        <TextBlock Text="DeepPCB-AOI API Connection"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#334155"
                                   Margin="0,8,0,8" />

                        <TextBlock Text="API Base URL" Margin="0,4,0,2" />
                        <TextBox Text="{Binding BaseUrl, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8,6"
                                 Margin="0,0,0,8" />

                        <TextBlock Text="Request Timeout (seconds, 1–300)" Margin="0,4,0,2" />
                        <TextBox Text="{Binding TimeoutSeconds, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8,6"
                                 Margin="0,0,0,12" />

                        <!-- Batch & Inspection Defaults -->
                        <TextBlock Text="Inspection &amp; Batch Defaults"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#334155"
                                   Margin="0,8,0,8" />

                        <TextBlock Text="Batch Concurrency (1–8)" Margin="0,4,0,2" />
                        <TextBox Text="{Binding Concurrency, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8,6"
                                 Margin="0,0,0,8" />

                        <TextBlock Text="Default IPC-A-600 Class" Margin="0,4,0,2" />
                        <ComboBox ItemsSource="{Binding AvailableIpcClasses}"
                                  SelectedItem="{Binding DefaultIpcClass}"
                                  Padding="8,6"
                                  Margin="0,0,0,8" />

                        <TextBlock Text="Default Batch ID" Margin="0,4,0,2" />
                        <TextBox Text="{Binding DefaultBatchId, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8,6"
                                 Margin="0,0,0,8" />

                        <CheckBox Content="Render industrial green solder-mask &amp; copper trace visuals (colorize_pcb)"
                                  IsChecked="{Binding ColorizePcb}"
                                  Margin="0,4,0,8" />

                        <CheckBox Content="Clean-Board Mode"
                                  IsChecked="{Binding DataContext.Inspect.CleanBoardMode, RelativeSource={RelativeSource AncestorType=Window}}"
                                  Margin="0,4,0,4" />
                        <CheckBox Content="Simulate Rogue VLM"
                                  IsChecked="{Binding DataContext.Inspect.SimulateRogueVlm, RelativeSource={RelativeSource AncestorType=Window}}"
                                  Margin="0,0,0,16" />

                        <!-- LLM Configuration -->
                        <TextBlock Text="LLM Explanation &amp; Query Settings (Verdicts Remain Rule-Based)"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#334155"
                                   Margin="0,8,0,8" />

                        <TextBlock Text="LLM Provider (API keys read from GEMINI_API_KEY / OPENAI_API_KEY env vars only)" Margin="0,4,0,2" />
                        <ComboBox ItemsSource="{Binding AvailableLlmProviders}"
                                  SelectedItem="{Binding LlmProvider}"
                                  Padding="8,6"
                                  Margin="0,0,0,8" />

                        <TextBlock Text="Model Name" Margin="0,4,0,2" />
                        <TextBox Text="{Binding ModelName, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8,6"
                                 Margin="0,0,0,8" />

                        <TextBlock Text="Summary Language" Margin="0,4,0,2" />
                        <ComboBox ItemsSource="{Binding AvailableSummaryLanguages}"
                                  SelectedItem="{Binding SummaryLanguage}"
                                  Padding="8,6"
                                  Margin="0,0,0,16" />

                        <!-- Actions -->
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,12">
                            <Button Content="Save Settings"
                                    Command="{Binding SaveSettingsCommand}"
                                    Padding="16,8"
                                    FontWeight="SemiBold"
                                    Background="#2563EB"
                                    Foreground="White"
                                    Margin="0,0,12,0" />

                            <Button Content="Check Backend Health"
                                    Command="{Binding CheckHealthNowCommand}"
                                    Padding="16,8" />
                        </StackPanel>

                        <TextBlock Text="{Binding StatusMessage}"
                                   FontWeight="SemiBold"
                                   Foreground="#0F172A"
                                   Margin="0,4,0,4" />

                        <TextBlock Text="{Binding HealthCheckResultText}"
                                   Foreground="#475569"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" BorderBrush="{StaticResource Brush.Line}" BorderThickness="0,1,0,0" Padding="16,6" Background="{StaticResource Brush.Paper}">
            <TextBlock Text="{Binding FooterText}" FontSize="12" Foreground="{StaticResource Brush.Muted}" />
        </Border>
    </Grid>
</Window>
