<Window x:Class="PcbInspectionViewer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PcbInspectionViewer.App.Controls"
        Title="PCB Inspection Viewer — DeepPCB-AOI Operator Station"
        Width="1360"
        Height="860"
        MinWidth="1080"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC"
        PreviewKeyDown="OnWindowPreviewKeyDown">
    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding Inspect.InspectCommand}" />
        <KeyBinding Key="Escape" Command="{Binding Inspect.CancelInspectCommand}" />
        <KeyBinding Key="F7" Command="{Binding OpenSettingsTabCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0"
                    SelectedIndex="{Binding SelectedTabIndex}"
                    Margin="12,12,12,8"
                    Background="White"
                    BorderBrush="#CBD5E1">
            <!-- Screen 1: Inspect (F1 / F2) -->
            <TabItem Header="1. Inspect">
                <Grid Margin="16" DataContext="{Binding Inspect}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="380" />
                    </Grid.ColumnDefinitions>

                    <!-- Left Column: Inputs & Controls -->
                    <Border Grid.Column="0"
                            Background="#F8FAFC"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16"
                            Margin="0,0,12,0"
                            AllowDrop="True"
                            PreviewDragOver="OnImageDropZoneDragOver"
                            Drop="OnTestImageDrop">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Single-Board Inspection (F1)"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="#0F172A"
                                           Margin="0,0,0,12" />

                                <!-- Golden Template Picker -->
                                <TextBlock Text="Golden Template Image (.jpg/.png/.bmp)"
                                           FontWeight="SemiBold"
                                           Foreground="#334155"
                                           Margin="0,4,0,4" />
                                <Border Background="White"
                                        BorderBrush="#CBD5E1"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="8"
                                        Margin="0,0,0,8"
                                        AllowDrop="True"
                                        PreviewDragOver="OnImageDropZoneDragOver"
                                        Drop="OnTemplateImageDrop">
                                    <StackPanel>
                                        <TextBox Text="{Binding TemplateImagePath, UpdateSourceTrigger=PropertyChanged}"
                                                 IsReadOnly="True"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 Foreground="#334155"
                                                 FontSize="12"
                                                 TextWrapping="Wrap"
                                                 ToolTip="{Binding TemplateImagePath}" />
                                        <Button Content="Browse Golden Template..."
                                                Click="OnBrowseTemplateClick"
                                                Margin="0,6,0,0"
                                                Padding="10,5" />
                                    </StackPanel>
                                </Border>

                                <!-- Clean-Board Mode -->
                                <CheckBox Content="Clean-Board Mode (Test = Template)"
                                          IsChecked="{Binding CleanBoardMode}"
                                          Margin="0,2,0,10" />

                                <!-- Test Image Picker -->
                                <TextBlock Text="Test Board Image (Ctrl+O or Drag &amp; Drop)"
                                           FontWeight="SemiBold"
                                           Foreground="#334155"
                                           Margin="0,4,0,4" />
                                <Border Background="White"
                                        BorderBrush="#CBD5E1"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="8"
                                        Margin="0,0,0,12"
                                        AllowDrop="True"
                                        PreviewDragOver="OnImageDropZoneDragOver"
                                        Drop="OnTestImageDrop">
                                    <StackPanel>
                                        <TextBox Text="{Binding TestImagePath, UpdateSourceTrigger=PropertyChanged}"
                                                 IsReadOnly="True"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 Foreground="#334155"
                                                 FontSize="12"
                                                 TextWrapping="Wrap"
                                                 ToolTip="{Binding TestImagePath}" />
                                        <Button Content="Browse Test Image (Ctrl+O)..."
                                                Click="OnBrowseTestClick"
                                                Margin="0,6,0,0"
                                                Padding="10,5" />
                                    </StackPanel>
                                </Border>

                                <!-- Batch ID & IPC Class -->
                                <TextBlock Text="Batch ID"
                                           FontWeight="SemiBold"
                                           Foreground="#334155"
                                           Margin="0,2,0,2" />
                                <TextBox Text="{Binding BatchId, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="8,6"
                                         Margin="0,0,0,10" />

                                <TextBlock Text="IPC-A-600 Class"
                                           FontWeight="SemiBold"
                                           Foreground="#334155"
                                           Margin="0,2,0,2" />
                                <ComboBox ItemsSource="{Binding AllowedIpcClasses}"
                                          SelectedItem="{Binding IpcClass}"
                                          Padding="8,6"
                                          Margin="0,0,0,10" />

                                <CheckBox Content="Colorize PCB (green solder-mask &amp; copper)"
                                          IsChecked="{Binding ColorizePcb}"
                                          Margin="0,2,0,6" />

                                <CheckBox Content="Simulate Rogue VLM (Guardrail Audit)"
                                          IsChecked="{Binding SimulateRogueVlm}"
                                          Margin="0,2,0,14" />

                                <!-- Inspect / Cancel Actions -->
                                <Grid Margin="0,4,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0"
                                            Content="Inspect Board (F5)"
                                            Command="{Binding InspectCommand}"
                                            Background="#2563EB"
                                            Foreground="White"
                                            FontWeight="Bold"
                                            Padding="12,10"
                                            Margin="0,0,8,0" />

                                    <Button Grid.Column="1"
                                            Content="Cancel (Esc)"
                                            Command="{Binding CancelInspectCommand}"
                                            Padding="12,10" />
                                </Grid>

                                <ProgressBar IsIndeterminate="True"
                                             Height="6"
                                             Margin="0,4,0,8"
                                             Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                <TextBlock Text="{Binding StatusOrErrorMessage}"
                                           TextWrapping="Wrap"
                                           FontSize="12.5"
                                           FontWeight="SemiBold"
                                           Foreground="#334155"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Center Column: Layer Toggle Bar + DefectOverlayCanvas -->
                    <Grid Grid.Column="1" Margin="0,0,12,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Background="#F1F5F9"
                                BorderBrush="#CBD5E1"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10,6"
                                Margin="0,0,0,8">
                            <WrapPanel VerticalAlignment="Center">
                                <TextBlock Text="Layer:"
                                           FontWeight="SemiBold"
                                           Foreground="#334155"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0" />
                                <Button Content="Test"
                                        Command="{Binding SelectLayerCommand}"
                                        CommandParameter="Test"
                                        Padding="10,4"
                                        Margin="0,0,6,0" />
                                <Button Content="Template"
                                        Command="{Binding SelectLayerCommand}"
                                        CommandParameter="Template"
                                        Padding="10,4"
                                        Margin="0,0,6,0" />
                                <Button Content="Diff (Heatmap)"
                                        Command="{Binding SelectLayerCommand}"
                                        CommandParameter="Diff"
                                        Padding="10,4"
                                        Margin="0,0,12,0" />

                                <CheckBox Content="Show Defect Boxes"
                                          IsChecked="{Binding ShowBoundingBoxes}"
                                          VerticalAlignment="Center"
                                          FontWeight="SemiBold"
                                          Margin="0,0,12,0" />

                                <Button Content="Reset Zoom (100%)"
                                        Command="{Binding ResetZoomAndPanCommand}"
                                        Padding="8,4" />
                            </WrapPanel>
                        </Border>

                        <Border Grid.Row="1"
                                BorderBrush="#CBD5E1"
                                BorderThickness="1"
                                CornerRadius="6"
                                ClipToBounds="True"
                                AllowDrop="True"
                                PreviewDragOver="OnImageDropZoneDragOver"
                                Drop="OnTestImageDrop">
                            <controls:DefectOverlayCanvas ImageDataUri="{Binding ActiveImageDataUri}"
                                                          Detections="{Binding Detections}"
                                                          ShowBoundingBoxes="{Binding ShowBoundingBoxes}"
                                                          ZoomFactor="{Binding ZoomFactor}"
                                                          PanX="{Binding PanX}"
                                                          PanY="{Binding PanY}" />
                        </Border>
                    </Grid>

                    <!-- Right Column: Verdict Badge, Line Halted Banner, Latency & Per-Defect IPC Decisions -->
                    <Border Grid.Column="2"
                            Background="#F8FAFC"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Deterministic Verdict Badge (never recomputed by client) -->
                            <Border Grid.Row="0"
                                    Background="{Binding VerdictText, Converter={StaticResource VerdictToBrushConverter}}"
                                    CornerRadius="8"
                                    Padding="16,12"
                                    Margin="0,0,0,10">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="SERVER BOARD DISPOSITION"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="#F8FAFC"
                                               HorizontalAlignment="Center"
                                               Opacity="0.9" />
                                    <TextBlock Text="{Binding VerdictText, Converter={StaticResource VerdictToDisplayLabelConverter}}"
                                               FontSize="24"
                                               FontWeight="ExtraBold"
                                               Foreground="White"
                                               HorizontalAlignment="Center"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- LINE HALTED Warning Banner -->
                            <Border Grid.Row="1"
                                    Background="#FEF2F2"
                                    BorderBrush="#EF4444"
                                    BorderThickness="2"
                                    CornerRadius="6"
                                    Padding="10,8"
                                    Margin="0,0,0,10"
                                    Visibility="{Binding IsLineHalted, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="🚨 LINE HALTED — Systemic Batch Failure Threshold Exceeded"
                                           Foreground="#B91C1C"
                                           FontWeight="Bold"
                                           TextWrapping="Wrap"
                                           HorizontalAlignment="Center" />
                            </Border>

                            <!-- Stage-1 Latency & Client Round-Trip Telemetry -->
                            <Border Grid.Row="2"
                                    Background="White"
                                    BorderBrush="#E2E8F0"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10,8"
                                    Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Stage-1 CV Latency" FontSize="11" Foreground="#64748B" />
                                        <TextBlock Text="{Binding Stage1LatencyMs, StringFormat={}{0:F1} ms}"
                                                   FontSize="14"
                                                   FontWeight="Bold"
                                                   Foreground="#0F172A" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Client Round-Trip" FontSize="11" Foreground="#64748B" />
                                        <TextBlock Text="{Binding RoundTripMs, StringFormat={}{0:F1} ms}"
                                                   FontSize="14"
                                                   FontWeight="Bold"
                                                   Foreground="#0F172A" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Per-Defect IPC Decisions List -->
                            <Grid Grid.Row="3">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Text="IPC-A-600 Defect Decisions"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="#0F172A"
                                           Margin="0,0,0,8" />

                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding AlignedDefects}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="White"
                                                        BorderBrush="#CBD5E1"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        Padding="10"
                                                        Margin="0,0,0,8">
                                                    <StackPanel>
                                                        <DockPanel Margin="0,0,0,4">
                                                            <Border DockPanel.Dock="Right"
                                                                    Background="{Binding Decision.Disposition, Converter={StaticResource VerdictToBrushConverter}}"
                                                                    CornerRadius="4"
                                                                    Padding="6,2">
                                                                <TextBlock Text="{Binding Decision.Disposition}"
                                                                           Foreground="White"
                                                                           FontWeight="Bold"
                                                                           FontSize="11" />
                                                            </Border>
                                                            <TextBlock FontWeight="Bold" FontSize="13" Foreground="#0F172A">
                                                                <Run Text="#" /><Run Text="{Binding Index, Mode=OneWay}" />
                                                                <Run Text=" " />
                                                                <Run Text="{Binding Detection.DefectClass, Mode=OneWay}" />
                                                                <Run Text=" (" /><Run Text="{Binding Detection.Confidence, StringFormat={}{0:P0}, Mode=OneWay}" /><Run Text=")" />
                                                            </TextBlock>
                                                        </DockPanel>

                                                        <TextBlock FontSize="12" Foreground="#334155" Margin="0,2,0,2">
                                                            <Run Text="Severity: " FontWeight="SemiBold" />
                                                            <Run Text="{Binding Decision.Severity, Mode=OneWay}" />
                                                            <Run Text=" · BBox: [" />
                                                            <Run Text="{Binding Detection.X1, Mode=OneWay}" /><Run Text="," />
                                                            <Run Text="{Binding Detection.Y1, Mode=OneWay}" /><Run Text="]–[" />
                                                            <Run Text="{Binding Detection.X2, Mode=OneWay}" /><Run Text="," />
                                                            <Run Text="{Binding Detection.Y2, Mode=OneWay}" /><Run Text="]" />
                                                        </TextBlock>

                                                        <TextBlock Text="{Binding Decision.IpcStandardClause}"
                                                                   FontSize="11.5"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#1E40AF"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0,2,0,4" />

                                                        <TextBlock FontSize="11.5" Foreground="#334155" TextWrapping="Wrap" Margin="0,0,0,2">
                                                            <Run Text="Electrical Risk: " FontWeight="SemiBold" />
                                                            <Run Text="{Binding Decision.ElectricalFailureRisk, Mode=OneWay}" />
                                                        </TextBlock>

                                                        <TextBlock FontSize="11.5" Foreground="#334155" TextWrapping="Wrap" Margin="0,0,0,2">
                                                            <Run Text="Root Cause: " FontWeight="SemiBold" />
                                                            <Run Text="{Binding Decision.RootCauseHypothesis, Mode=OneWay}" />
                                                        </TextBlock>

                                                        <TextBlock FontSize="11.5" Foreground="#334155" TextWrapping="Wrap" Margin="0,0,0,2">
                                                            <Run Text="Action: " FontWeight="SemiBold" />
                                                            <Run Text="{Binding Decision.RecommendedCorrectiveAction, Mode=OneWay}" />
                                                        </TextBlock>

                                                        <Border Background="#FEF3C7"
                                                                BorderBrush="#F59E0B"
                                                                BorderThickness="1"
                                                                CornerRadius="4"
                                                                Padding="6,4"
                                                                Margin="0,4,0,0"
                                                                Visibility="{Binding Decision.GuardrailOverridden, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <TextBlock FontSize="11" Foreground="#92400E" TextWrapping="Wrap">
                                                                <Run Text="🛡 Guardrail Override: " FontWeight="Bold" />
                                                                <Run Text="{Binding Decision.OverrideReason, Mode=OneWay}" />
                                                            </TextBlock>
                                                        </Border>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Screen 2: History (F3) -->
            <TabItem Header="2. History">
                <Grid Margin="24">
                    <TextBlock Text="Inspection History &amp; Drill-Down (Ready for Milestone D8–10)"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#334155" />
                </Grid>
            </TabItem>

            <!-- Screen 3: Dashboard (F4) -->
            <TabItem Header="3. Dashboard">
                <Grid Margin="24">
                    <TextBlock Text="Daily Yield &amp; Throughput Dashboard (Ready for Milestone D11–12)"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#334155" />
                </Grid>
            </TabItem>

            <!-- Screen 4: Ask (P2) -->
            <TabItem Header="4. Ask (NL → SQL)">
                <Grid Margin="24">
                    <TextBlock Text="Guarded Natural-Language History Query (Ready for Milestone D13–14)"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#334155" />
                </Grid>
            </TabItem>

            <!-- Screen 5: Settings (F7) -->
            <TabItem Header="5. Settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
                    <StackPanel MaxWidth="680" HorizontalAlignment="Left" DataContext="{Binding Settings}">
                        <TextBlock Text="Station &amp; Backend Settings (F7)"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"
                                   Margin="0,0,0,16" />

                        <!-- API Settings -->
                        <TextBlock Text="DeepPCB-AOI API Connection"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#334155"
                                   Margin="0,8,0,8" />

                        <TextBlock Text="API Base URL" Margin="0,4,0,2" />
                        <TextBox Text="{Binding BaseUrl, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8,6"
                                 Margin="0,0,0,8" />

                        <TextBlock Text="Request Timeout (seconds, 1–300)" Margin="0,4,0,2" />
                        <TextBox Text="{Binding TimeoutSeconds, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8,6"
                                 Margin="0,0,0,12" />

                        <!-- Batch & Inspection Defaults -->
                        <TextBlock Text="Inspection &amp; Batch Defaults"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#334155"
                                   Margin="0,8,0,8" />

                        <TextBlock Text="Batch Concurrency (1–8)" Margin="0,4,0,2" />
                        <TextBox Text="{Binding Concurrency, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8,6"
                                 Margin="0,0,0,8" />

                        <TextBlock Text="Default IPC-A-600 Class" Margin="0,4,0,2" />
                        <ComboBox ItemsSource="{Binding AvailableIpcClasses}"
                                  SelectedItem="{Binding DefaultIpcClass}"
                                  Padding="8,6"
                                  Margin="0,0,0,8" />

                        <TextBlock Text="Default Batch ID" Margin="0,4,0,2" />
                        <TextBox Text="{Binding DefaultBatchId, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8,6"
                                 Margin="0,0,0,8" />

                        <CheckBox Content="Render industrial green solder-mask &amp; copper trace visuals (colorize_pcb)"
                                  IsChecked="{Binding ColorizePcb}"
                                  Margin="0,4,0,16" />

                        <!-- LLM Configuration -->
                        <TextBlock Text="LLM Explanation &amp; Query Settings (Verdicts Remain Rule-Based)"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#334155"
                                   Margin="0,8,0,8" />

                        <TextBlock Text="LLM Provider (API keys read from GEMINI_API_KEY / OPENAI_API_KEY env vars only)" Margin="0,4,0,2" />
                        <ComboBox ItemsSource="{Binding AvailableLlmProviders}"
                                  SelectedItem="{Binding LlmProvider}"
                                  Padding="8,6"
                                  Margin="0,0,0,8" />

                        <TextBlock Text="Model Name" Margin="0,4,0,2" />
                        <TextBox Text="{Binding ModelName, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8,6"
                                 Margin="0,0,0,8" />

                        <TextBlock Text="Summary Language" Margin="0,4,0,2" />
                        <ComboBox ItemsSource="{Binding AvailableSummaryLanguages}"
                                  SelectedItem="{Binding SummaryLanguage}"
                                  Padding="8,6"
                                  Margin="0,0,0,16" />

                        <!-- Actions -->
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,12">
                            <Button Content="Save Settings"
                                    Command="{Binding SaveSettingsCommand}"
                                    Padding="16,8"
                                    FontWeight="SemiBold"
                                    Background="#2563EB"
                                    Foreground="White"
                                    Margin="0,0,12,0" />

                            <Button Content="Check Backend Health"
                                    Command="{Binding CheckHealthNowCommand}"
                                    Padding="16,8" />
                        </StackPanel>

                        <TextBlock Text="{Binding StatusMessage}"
                                   FontWeight="SemiBold"
                                   Foreground="#0F172A"
                                   Margin="0,4,0,4" />

                        <TextBlock Text="{Binding HealthCheckResultText}"
                                   Foreground="#475569"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Bottom Status Bar (§7.5) -->
        <StatusBar Grid.Row="1"
                   Background="#0F172A"
                   Foreground="#F8FAFC"
                   Padding="12,6">
            <StatusBarItem>
                <Border Background="{Binding IsBackendOnline, Converter={StaticResource OnlineToStatusBrushConverter}}"
                        CornerRadius="10"
                        Padding="10,2"
                        ToolTip="{Binding BackendStatusTooltip}">
                    <TextBlock Text="{Binding BackendStatusText}"
                               Foreground="White"
                               FontWeight="SemiBold"
                               FontSize="12" />
                </Border>
            </StatusBarItem>

            <Separator Background="#334155" Margin="8,0" />

            <StatusBarItem>
                <TextBlock Text="{Binding DetectorAndVersionText}"
                           Foreground="#E2E8F0"
                           FontSize="12" />
            </StatusBarItem>

            <Separator Background="#334155" Margin="8,0" />

            <StatusBarItem>
                <TextBlock Text="{Binding DatabasePathText}"
                           Foreground="#94A3B8"
                           FontSize="12"
                           ToolTip="Local SQLite inspection history path" />
            </StatusBarItem>

            <Separator Background="#334155" Margin="8,0" />

            <StatusBarItem>
                <TextBlock Text="{Binding LlmProviderStatusText}"
                           Foreground="#E2E8F0"
                           FontSize="12" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
