<Window x:Class="PcbInspectionViewer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PcbInspectionViewer.App.Controls"
        Title="PCB Inspection Viewer — DeepPCB-AOI Operator Station"
        Width="1360"
        Height="860"
        MinWidth="1080"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC"
        PreviewKeyDown="OnWindowPreviewKeyDown">
    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding Inspect.InspectCommand}" />
        <KeyBinding Key="Escape" Command="{Binding Inspect.CancelInspectCommand}" />
        <KeyBinding Key="F2" Command="{Binding OpenBatchTabCommand}" />
        <KeyBinding Key="F3" Command="{Binding OpenHistoryTabCommand}" />
        <KeyBinding Key="F7" Command="{Binding OpenSettingsTabCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0"
                    SelectedIndex="{Binding SelectedTabIndex}"
                    Margin="12,12,12,8"
                    Background="White"
                    BorderBrush="#CBD5E1">
            <!-- Screen 1: Single Inspect (F1) -->
            <TabItem Header="1. Single Inspect (F1)">
                <Grid Margin="16" DataContext="{Binding Inspect}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="380" />
                    </Grid.ColumnDefinitions>

                    <!-- Left Column: Inputs & Controls -->
                    <Border Grid.Column="0"
                            Background="#F8FAFC"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16"
                            Margin="0,0,12,0"
                            AllowDrop="True"
                            PreviewDragOver="OnImageDropZoneDragOver"
                            Drop="OnTestImageDrop">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Single-Board Inspection (F1)"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="#0F172A"
                                           Margin="0,0,0,12" />

                                <!-- Golden Template Picker -->
                                <TextBlock Text="Golden Template Image (.jpg/.png/.bmp)"
                                           FontWeight="SemiBold"
                                           Foreground="#334155"
                                           Margin="0,4,0,4" />
                                <Border Background="White"
                                        BorderBrush="#CBD5E1"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="8"
                                        Margin="0,0,0,8"
                                        AllowDrop="True"
                                        PreviewDragOver="OnImageDropZoneDragOver"
                                        Drop="OnTemplateImageDrop">
                                    <StackPanel>
                                        <TextBox Text="{Binding TemplateImagePath, UpdateSourceTrigger=PropertyChanged}"
                                                 IsReadOnly="True"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 Foreground="#334155"
                                                 FontSize="12"
                                                 TextWrapping="Wrap"
                                                 ToolTip="{Binding TemplateImagePath}" />
                                        <Button Content="Browse Golden Template..."
                                                Click="OnBrowseTemplateClick"
                                                Margin="0,6,0,0"
                                                Padding="10,5" />
                                    </StackPanel>
                                </Border>

                                <!-- Clean-Board Mode -->
                                <CheckBox Content="Clean-Board Mode (Test = Template)"
                                          IsChecked="{Binding CleanBoardMode}"
                                          Margin="0,2,0,10" />

                                <!-- Test Image Picker -->
                                <TextBlock Text="Test Board Image (Ctrl+O or Drag &amp; Drop)"
                                           FontWeight="SemiBold"
                                           Foreground="#334155"
                                           Margin="0,4,0,4" />
                                <Border Background="White"
                                        BorderBrush="#CBD5E1"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="8"
                                        Margin="0,0,0,12"
                                        AllowDrop="True"
                                        PreviewDragOver="OnImageDropZoneDragOver"
                                        Drop="OnTestImageDrop">
                                    <StackPanel>
                                        <TextBox Text="{Binding TestImagePath, UpdateSourceTrigger=PropertyChanged}"
                                                 IsReadOnly="True"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 Foreground="#334155"
                                                 FontSize="12"
                                                 TextWrapping="Wrap"
                                                 ToolTip="{Binding TestImagePath}" />
                                        <Button Content="Browse Test Image (Ctrl+O)..."
                                                Click="OnBrowseTestClick"
                                                Margin="0,6,0,0"
                                                Padding="10,5" />
                                    </StackPanel>
                                </Border>

                                <!-- Batch ID & IPC Class -->
                                <TextBlock Text="Batch ID"
                                           FontWeight="SemiBold"
                                           Foreground="#334155"
                                           Margin="0,2,0,2" />
                                <TextBox Text="{Binding BatchId, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="8,6"
                                         Margin="0,0,0,10" />

                                <TextBlock Text="IPC-A-600 Class"
                                           FontWeight="SemiBold"
                                           Foreground="#334155"
                                           Margin="0,2,0,2" />
                                <ComboBox ItemsSource="{Binding AllowedIpcClasses}"
                                          SelectedItem="{Binding IpcClass}"
                                          Padding="8,6"
                                          Margin="0,0,0,10" />

                                <CheckBox Content="Colorize PCB (green solder-mask &amp; copper)"
                                          IsChecked="{Binding ColorizePcb}"
                                          Margin="0,2,0,6" />

                                <CheckBox Content="Simulate Rogue VLM (Guardrail Audit)"
                                          IsChecked="{Binding SimulateRogueVlm}"
                                          Margin="0,2,0,14" />

                                <!-- Inspect / Cancel Actions -->
                                <Grid Margin="0,4,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0"
                                            Content="Inspect Board (F5)"
                                            Command="{Binding InspectCommand}"
                                            Background="#2563EB"
                                            Foreground="White"
                                            FontWeight="Bold"
                                            Padding="12,10"
                                            Margin="0,0,8,0" />

                                    <Button Grid.Column="1"
                                            Content="Cancel (Esc)"
                                            Command="{Binding CancelInspectCommand}"
                                            Padding="12,10" />
                                </Grid>

                                <ProgressBar IsIndeterminate="True"
                                             Height="6"
                                             Margin="0,4,0,8"
                                             Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                <TextBlock Text="{Binding StatusOrErrorMessage}"
                                           TextWrapping="Wrap"
                                           FontSize="12.5"
                                           FontWeight="SemiBold"
                                           Foreground="#334155"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Center Column: Layer Toggle Bar + DefectOverlayCanvas -->
                    <Grid Grid.Column="1" Margin="0,0,12,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Background="#F1F5F9"
                                BorderBrush="#CBD5E1"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10,6"
                                Margin="0,0,0,8">
                            <WrapPanel VerticalAlignment="Center">
                                <TextBlock Text="Layer:"
                                           FontWeight="SemiBold"
                                           Foreground="#334155"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0" />
                                <Button Content="Test"
                                        Command="{Binding SelectLayerCommand}"
                                        CommandParameter="Test"
                                        Padding="10,4"
                                        Margin="0,0,6,0" />
                                <Button Content="Template"
                                        Command="{Binding SelectLayerCommand}"
                                        CommandParameter="Template"
                                        Padding="10,4"
                                        Margin="0,0,6,0" />
                                <Button Content="Diff (Heatmap)"
                                        Command="{Binding SelectLayerCommand}"
                                        CommandParameter="Diff"
                                        Padding="10,4"
                                        Margin="0,0,12,0" />

                                <CheckBox Content="Show Defect Boxes"
                                          IsChecked="{Binding ShowBoundingBoxes}"
                                          VerticalAlignment="Center"
                                          FontWeight="SemiBold"
                                          Margin="0,0,12,0" />

                                <Button Content="Reset Zoom (100%)"
                                        Command="{Binding ResetZoomAndPanCommand}"
                                        Padding="8,4" />
                            </WrapPanel>
                        </Border>

                        <Border Grid.Row="1"
                                BorderBrush="#CBD5E1"
                                BorderThickness="1"
                                CornerRadius="6"
                                ClipToBounds="True"
                                AllowDrop="True"
                                PreviewDragOver="OnImageDropZoneDragOver"
                                Drop="OnTestImageDrop">
                            <controls:DefectOverlayCanvas ImageDataUri="{Binding ActiveImageDataUri}"
                                                          Detections="{Binding Detections}"
                                                          ShowBoundingBoxes="{Binding ShowBoundingBoxes}"
                                                          ZoomFactor="{Binding ZoomFactor}"
                                                          PanX="{Binding PanX}"
                                                          PanY="{Binding PanY}" />
                        </Border>
                    </Grid>

                    <!-- Right Column: Verdict Badge, Line Halted Banner, Latency & Per-Defect IPC Decisions -->
                    <Border Grid.Column="2"
                            Background="#F8FAFC"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Deterministic Verdict Badge (never recomputed by client) -->
                            <Border Grid.Row="0"
                                    Background="{Binding VerdictText, Converter={StaticResource VerdictToBrushConverter}}"
                                    CornerRadius="8"
                                    Padding="16,12"
                                    Margin="0,0,0,10">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="SERVER BOARD DISPOSITION"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="#F8FAFC"
                                               HorizontalAlignment="Center"
                                               Opacity="0.9" />
                                    <TextBlock Text="{Binding VerdictText, Converter={StaticResource VerdictToDisplayLabelConverter}}"
                                               FontSize="24"
                                               FontWeight="ExtraBold"
                                               Foreground="White"
                                               HorizontalAlignment="Center"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- LINE HALTED Warning Banner -->
                            <Border Grid.Row="1"
                                    Background="#FEF2F2"
                                    BorderBrush="#EF4444"
                                    BorderThickness="2"
                                    CornerRadius="6"
                                    Padding="10,8"
                                    Margin="0,0,0,10"
                                    Visibility="{Binding IsLineHalted, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="🚨 LINE HALTED — Systemic Batch Failure Threshold Exceeded"
                                           Foreground="#B91C1C"
                                           FontWeight="Bold"
                                           TextWrapping="Wrap"
                                           HorizontalAlignment="Center" />
                            </Border>

                            <!-- Stage-1 Latency & Client Round-Trip Telemetry -->
                            <Border Grid.Row="2"
                                    Background="White"
                                    BorderBrush="#E2E8F0"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10,8"
                                    Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Stage-1 CV Latency" FontSize="11" Foreground="#64748B" />
                                        <TextBlock Text="{Binding Stage1LatencyMs, StringFormat={}{0:F1} ms}"
                                                   FontSize="14"
                                                   FontWeight="Bold"
                                                   Foreground="#0F172A" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Client Round-Trip" FontSize="11" Foreground="#64748B" />
                                        <TextBlock Text="{Binding RoundTripMs, StringFormat={}{0:F1} ms}"
                                                   FontSize="14"
                                                   FontWeight="Bold"
                                                   Foreground="#0F172A" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Per-Defect IPC Decisions List -->
                            <Grid Grid.Row="3">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Text="IPC-A-600 Defect Decisions"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="#0F172A"
                                           Margin="0,0,0,8" />

                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding AlignedDefects}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="White"
                                                        BorderBrush="#CBD5E1"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        Padding="10"
                                                        Margin="0,0,0,8">
                                                    <StackPanel>
                                                        <DockPanel Margin="0,0,0,4">
                                                            <Border DockPanel.Dock="Right"
                                                                    Background="{Binding Decision.Disposition, Converter={StaticResource VerdictToBrushConverter}}"
                                                                    CornerRadius="4"
                                                                    Padding="6,2">
                                                                <TextBlock Text="{Binding Decision.Disposition}"
                                                                           Foreground="White"
                                                                           FontWeight="Bold"
                                                                           FontSize="11" />
                                                            </Border>
                                                            <TextBlock FontWeight="Bold" FontSize="13" Foreground="#0F172A">
                                                                <Run Text="#" /><Run Text="{Binding Index, Mode=OneWay}" />
                                                                <Run Text=" " />
                                                                <Run Text="{Binding Detection.DefectClass, Mode=OneWay}" />
                                                                <Run Text=" (" /><Run Text="{Binding Detection.Confidence, StringFormat={}{0:P0}, Mode=OneWay}" /><Run Text=")" />
                                                            </TextBlock>
                                                        </DockPanel>

                                                        <TextBlock FontSize="12" Foreground="#334155" Margin="0,2,0,2">
                                                            <Run Text="Severity: " FontWeight="SemiBold" />
                                                            <Run Text="{Binding Decision.Severity, Mode=OneWay}" />
                                                            <Run Text=" · BBox: [" />
                                                            <Run Text="{Binding Detection.X1, Mode=OneWay}" /><Run Text="," />
                                                            <Run Text="{Binding Detection.Y1, Mode=OneWay}" /><Run Text="]–[" />
                                                            <Run Text="{Binding Detection.X2, Mode=OneWay}" /><Run Text="," />
                                                            <Run Text="{Binding Detection.Y2, Mode=OneWay}" /><Run Text="]" />
                                                        </TextBlock>

                                                        <TextBlock Text="{Binding Decision.IpcStandardClause}"
                                                                   FontSize="11.5"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#1E40AF"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0,2,0,4" />

                                                        <TextBlock FontSize="11.5" Foreground="#334155" TextWrapping="Wrap" Margin="0,0,0,2">
                                                            <Run Text="Electrical Risk: " FontWeight="SemiBold" />
                                                            <Run Text="{Binding Decision.ElectricalFailureRisk, Mode=OneWay}" />
                                                        </TextBlock>

                                                        <TextBlock FontSize="11.5" Foreground="#334155" TextWrapping="Wrap" Margin="0,0,0,2">
                                                            <Run Text="Root Cause: " FontWeight="SemiBold" />
                                                            <Run Text="{Binding Decision.RootCauseHypothesis, Mode=OneWay}" />
                                                        </TextBlock>

                                                        <TextBlock FontSize="11.5" Foreground="#334155" TextWrapping="Wrap" Margin="0,0,0,2">
                                                            <Run Text="Action: " FontWeight="SemiBold" />
                                                            <Run Text="{Binding Decision.RecommendedCorrectiveAction, Mode=OneWay}" />
                                                        </TextBlock>

                                                        <Border Background="#FEF3C7"
                                                                BorderBrush="#F59E0B"
                                                                BorderThickness="1"
                                                                CornerRadius="4"
                                                                Padding="6,4"
                                                                Margin="0,4,0,0"
                                                                Visibility="{Binding Decision.GuardrailOverridden, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <TextBlock FontSize="11" Foreground="#92400E" TextWrapping="Wrap">
                                                                <Run Text="🛡 Guardrail Override: " FontWeight="Bold" />
                                                                <Run Text="{Binding Decision.OverrideReason, Mode=OneWay}" />
                                                            </TextBlock>
                                                        </Border>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Screen 2: Batch Inspect (F2) -->
            <TabItem Header="2. Batch Inspect (F2)">
                <Grid Margin="16" DataContext="{Binding Batch}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Top Config & Action Bar -->
                    <Border Grid.Row="0"
                            Background="#F8FAFC"
                            BorderBrush="#CBD5E1"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16"
                            Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Folder Selection -->
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="Target Boards Folder" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding FolderPath, UpdateSourceTrigger=PropertyChanged}" Padding="6,5" />
                                    <Button Grid.Column="1" Content="Browse..." Click="OnBrowseBatchFolderClick" Padding="10,5" Margin="6,0,0,0" />
                                </Grid>
                                <CheckBox Content="DeepPCB auto-pairing (&lt;id&gt;_test ↔ &lt;id&gt;_temp)"
                                          IsChecked="{Binding UseDeepPcbAutoPairing}"
                                          FontWeight="SemiBold"
                                          Margin="0,6,0,0" />
                            </StackPanel>

                            <!-- Global Template (Disabled if DeepPCB auto-pairing) -->
                            <StackPanel Grid.Column="1" Margin="0,0,12,0" IsEnabled="{Binding UseDeepPcbAutoPairing, Converter={StaticResource InverseBooleanConverter}}">
                                <TextBlock Text="Global Golden Template (Single-template mode)" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding GlobalTemplatePath, UpdateSourceTrigger=PropertyChanged}" Padding="6,5" />
                                    <Button Grid.Column="1" Content="Browse..." Click="OnBrowseBatchTemplateClick" Padding="10,5" Margin="6,0,0,0" />
                                </Grid>
                            </StackPanel>

                            <!-- Options -->
                            <StackPanel Grid.Column="2" Margin="0,0,12,0">
                                <TextBlock Text="Batch ID / IPC / Concurrency" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="40" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding BatchId, UpdateSourceTrigger=PropertyChanged}" Padding="6,5" Margin="0,0,4,0" ToolTip="Batch Identifier" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding AllowedIpcClasses}" SelectedItem="{Binding IpcClass}" Padding="4,4" Margin="0,0,4,0" ToolTip="IPC-A-600 Class" />
                                    <TextBox Grid.Column="2" Text="{Binding Concurrency, UpdateSourceTrigger=PropertyChanged}" Padding="6,5" ToolTip="Concurrency (1–8)" />
                                </Grid>
                                <CheckBox Content="Colorize PCB visuals" IsChecked="{Binding ColorizePcb}" Margin="0,6,0,0" />
                            </StackPanel>

                            <!-- Actions -->
                            <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                <Button Content="Start Batch (F2)"
                                        Command="{Binding StartBatchCommand}"
                                        Background="#2563EB"
                                        Foreground="White"
                                        FontWeight="Bold"
                                        Padding="16,8"
                                        Margin="0,0,0,6" />
                                <Button Content="Cancel Batch"
                                        Command="{Binding CancelBatchCommand}"
                                        Padding="16,6" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Progress & KPI Metrics Card -->
                    <Border Grid.Row="1"
                            Background="White"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16,12"
                            Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding StatusMessage}" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Progress: " FontWeight="SemiBold" Foreground="#64748B" />
                                    <TextBlock Text="{Binding CompletedCount}" FontWeight="Bold" Foreground="#10B981" />
                                    <TextBlock Text=" passed/done, " Foreground="#64748B" />
                                    <TextBlock Text="{Binding FailedCount}" FontWeight="Bold" Foreground="#EF4444" />
                                    <TextBlock Text=" failed / " Foreground="#64748B" />
                                    <TextBlock Text="{Binding TotalItems}" FontWeight="Bold" Foreground="#0F172A" />
                                    <TextBlock Text=" total · Elapsed: " Foreground="#64748B" Margin="8,0,0,0" />
                                    <TextBlock Text="{Binding ElapsedText}" FontWeight="Bold" Foreground="#0F172A" />
                                    <TextBlock Text=" · ETA: " Foreground="#64748B" Margin="4,0,0,0" />
                                    <TextBlock Text="{Binding EtaText}" FontWeight="Bold" Foreground="#0F172A" />
                                </StackPanel>
                            </Grid>

                            <ProgressBar Grid.Row="1" Value="{Binding PercentComplete}" Height="8" Minimum="0" Maximum="100" />
                        </Grid>
                    </Border>

                    <!-- Batch Items Virtualized Live DataGrid -->
                    <Border Grid.Row="2"
                            BorderBrush="#CBD5E1"
                            BorderThickness="1"
                            CornerRadius="6">
                        <DataGrid ItemsSource="{Binding Items}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserSortColumns="True"
                                  EnableRowVirtualization="True"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#E2E8F0"
                                  RowHeight="32"
                                  Background="White"
                                  BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="50" />
                                <DataGridTextColumn Header="File Name" Binding="{Binding FileName}" Width="240" />
                                <DataGridTemplateColumn Header="Status" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding Status, Converter={StaticResource BatchStatusToBrushConverter}}"
                                                    CornerRadius="4"
                                                    Padding="6,2"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Status}" Foreground="White" FontWeight="Bold" FontSize="11" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Verdict" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding Verdict, Converter={StaticResource VerdictToBrushConverter}}"
                                                    CornerRadius="4"
                                                    Padding="6,2"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding Verdict, Converter={StaticResource NullOrEmptyToVisibilityConverter}}">
                                                <TextBlock Text="{Binding Verdict}" Foreground="White" FontWeight="Bold" FontSize="11" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="# Defects" Binding="{Binding DefectCount}" Width="80" />
                                <DataGridTextColumn Header="Stage-1 Latency" Binding="{Binding Stage1LatencyMs, StringFormat={}{0:F1} ms}" Width="120" />
                                <DataGridTextColumn Header="Notes / Errors" Binding="{Binding ErrorMessage}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Screen 3: History (F3) -->
            <TabItem Header="3. History (F3)">
                <Grid Margin="16" DataContext="{Binding History}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Filter Control Bar -->
                    <Border Grid.Row="0"
                            Background="#F8FAFC"
                            BorderBrush="#CBD5E1"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12,10"
                            Margin="0,0,0,12">
                        <WrapPanel VerticalAlignment="Center">
                            <!-- Verdict filter -->
                            <TextBlock Text="Verdict:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,6,0" />
                            <ComboBox ItemsSource="{Binding AvailableVerdicts}"
                                      SelectedItem="{Binding SelectedVerdict}"
                                      Width="100"
                                      Padding="6,4"
                                      Margin="0,0,16,0" />

                            <!-- Batch filter -->
                            <TextBlock Text="Batch:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,6,0" />
                            <ComboBox ItemsSource="{Binding AvailableBatches}"
                                      SelectedItem="{Binding SelectedBatch}"
                                      Width="140"
                                      Padding="6,4"
                                      Margin="0,0,16,0" />

                            <!-- Date Range filters (Spec Gap 1) -->
                            <TextBlock Text="From:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,6,0" />
                            <DatePicker SelectedDate="{Binding StartDate}" Width="120" Margin="0,0,12,0" />

                            <TextBlock Text="To:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,6,0" />
                            <DatePicker SelectedDate="{Binding EndDate}" Width="120" Margin="0,0,16,0" />

                            <!-- File search -->
                            <TextBlock Text="File:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,6,0" />
                            <TextBox Text="{Binding FileNameSearch, UpdateSourceTrigger=PropertyChanged}"
                                     Width="140"
                                     Padding="6,4"
                                     Margin="0,0,16,0" />

                            <!-- Defect classes multi-select pills -->
                            <TextBlock Text="Defect Classes:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,8,0" />
                            <ItemsControl ItemsSource="{Binding AvailableDefectClasses}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding}"
                                                Command="{Binding DataContext.ToggleDefectClassFilterCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Padding="8,3"
                                                Margin="0,0,6,0"
                                                FontSize="11.5" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Actions -->
                            <Button Content="Search"
                                    Command="{Binding LoadHistoryCommand}"
                                    Background="#2563EB"
                                    Foreground="White"
                                    FontWeight="SemiBold"
                                    Padding="14,5"
                                    Margin="8,0,8,0" />

                            <Button Content="Clear Filters"
                                    Command="{Binding ClearFiltersCommand}"
                                    Padding="10,5"
                                    Margin="0,0,16,0" />

                            <!-- Export buttons (F5) -->
                            <Button Content="Export CSV"
                                    Click="OnExportHistoryCsvClicked"
                                    Background="#059669"
                                    Foreground="White"
                                    FontWeight="SemiBold"
                                    Padding="10,5"
                                    Margin="0,0,8,0" />

                            <Button Content="Export PDF"
                                    Click="OnExportHistoryPdfClicked"
                                    Background="#D97706"
                                    Foreground="White"
                                    FontWeight="SemiBold"
                                    Padding="10,5" />
                        </WrapPanel>
                    </Border>

                    <!-- Virtualized DataGrid -->
                    <Border Grid.Row="1"
                            BorderBrush="#CBD5E1"
                            BorderThickness="1"
                            CornerRadius="6">
                        <DataGrid ItemsSource="{Binding Items}"
                                  SelectedItem="{Binding SelectedItem}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserSortColumns="True"
                                  CanUserResizeColumns="True"
                                  EnableRowVirtualization="True"
                                  EnableColumnVirtualization="True"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  ScrollViewer.IsDeferredScrollingEnabled="True"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#E2E8F0"
                                  RowHeight="34"
                                  Background="White"
                                  BorderThickness="0"
                                  SelectionMode="Single"
                                  MouseDoubleClick="OnHistoryDataGridMouseDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Time (Local)" Binding="{Binding InspectedAtLocal, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Width="150" />
                                <DataGridTextColumn Header="File Name" Binding="{Binding FileName}" Width="160" />
                                <DataGridTextColumn Header="Batch ID" Binding="{Binding BatchId}" Width="120" />
                                <DataGridTemplateColumn Header="Verdict" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding BoardDisposition, Converter={StaticResource VerdictToBrushConverter}}"
                                                    CornerRadius="4"
                                                    Padding="6,2"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding BoardDisposition}"
                                                           Foreground="White"
                                                           FontWeight="Bold"
                                                           FontSize="11" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="# Defects" Binding="{Binding DefectCount}" Width="80" />
                                <DataGridTextColumn Header="Defect Classes" Binding="{Binding DefectClassesSummary}" Width="*" />
                                <DataGridTextColumn Header="Stage-1 Latency" Binding="{Binding Stage1LatencyMs, StringFormat={}{0:F1} ms}" Width="110" />
                                <DataGridTextColumn Header="Round-Trip" Binding="{Binding RoundTripMs, StringFormat={}{0:F1} ms}" Width="100" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- Bottom History Status / Actions -->
                    <DockPanel Grid.Row="2" Margin="0,8,0,0">
                        <Button DockPanel.Dock="Right"
                                Content="Open Data Folder"
                                Click="OnOpenDataFolderClick"
                                Padding="12,5" />
                        <TextBlock Text="{Binding StatusMessage}"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Foreground="#475569" />
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- Screen 3: Dashboard (F4) -->
            <TabItem Header="3. Dashboard (F4)">
                <Grid Margin="16" DataContext="{Binding Dashboard}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Top Bar: Date selection and Refresh -->
                    <Border Grid.Row="0" Background="#F1F5F9" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                        <DockPanel LastChildFill="False">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                <TextBlock Text="Target Day:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#0F172A" />
                                <DatePicker SelectedDate="{Binding SelectedDate, Mode=TwoWay}" Width="140" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <Button Content="Refresh Metrics" Command="{Binding RefreshDashboardCommand}" Padding="12,6" Background="#0284C7" Foreground="White" BorderThickness="0" Cursor="Hand" />
                            </StackPanel>
                            <TextBlock Text="{Binding StatusMessage}" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="#64748B" FontStyle="Italic" />
                        </DockPanel>
                    </Border>

                    <!-- KPI Cards Row -->
                    <UniformGrid Grid.Row="1" Columns="5" Margin="0,0,0,16">
                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="BOARDS INSPECTED" FontSize="11" FontWeight="Bold" Foreground="#64748B" />
                                <TextBlock Text="{Binding TotalInspected}" FontSize="24" FontWeight="Bold" Foreground="#0F172A" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Background="White" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="PASS COUNT" FontSize="11" FontWeight="Bold" Foreground="#15803D" />
                                <TextBlock Text="{Binding PassCount}" FontSize="24" FontWeight="Bold" Foreground="#16A34A" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Background="White" BorderBrush="#FEF08A" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="REWORK REQUIRED" FontSize="11" FontWeight="Bold" Foreground="#B45309" />
                                <TextBlock Text="{Binding ReworkCount}" FontSize="24" FontWeight="Bold" Foreground="#D97706" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Background="White" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="SCRAP" FontSize="11" FontWeight="Bold" Foreground="#B91C1C" />
                                <TextBlock Text="{Binding ScrapCount}" FontSize="24" FontWeight="Bold" Foreground="#DC2626" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Background="White" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="8" Padding="14">
                            <StackPanel>
                                <TextBlock Text="OVERALL YIELD" FontSize="11" FontWeight="Bold" Foreground="#0369A1" />
                                <TextBlock Text="{Binding YieldPercentage, StringFormat={}{0:F1}%}" FontSize="24" FontWeight="Bold" Foreground="#0284C7" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Main Panels: Top Defects & Hourly Throughput -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="380" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: Top Defect Classes & Halted Line Status -->
                        <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,12,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="Top Defect Distribution" FontSize="15" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,12" />
                                    <ItemsControl ItemsSource="{Binding TopDefectClasses}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="0,6,0,6">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="{Binding DefectClass}" FontWeight="SemiBold" Foreground="#334155" />
                                                            <TextBlock Text="{Binding Count, StringFormat={}{0} occurrences}" FontSize="11" Foreground="#64748B" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Text="{Binding Percentage, StringFormat={}{0:F1}%}" FontWeight="Bold" Foreground="#0284C7" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Separator Margin="0,16,0,16" Background="#E2E8F0" />
                                    <TextBlock Text="Quality Guardrail Status" FontSize="15" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,8" />
                                    <TextBlock Text="Halted Batches Count:" FontSize="12" Foreground="#64748B" />
                                    <TextBlock Text="{Binding HaltedBatchesCount}" FontSize="18" FontWeight="Bold" Foreground="#DC2626" Margin="0,2,0,8" />
                                    <TextBlock Text="Halted Batch IDs:" FontSize="12" Foreground="#64748B" />
                                    <TextBlock Text="{Binding HaltedBatchesSummary}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="#334155" />
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <!-- Right: Hourly Throughput Table -->
                        <Border Grid.Column="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16">
                            <DockPanel>
                                <TextBlock Text="Hourly Throughput (24 Hours)" FontSize="15" FontWeight="Bold" Foreground="#0F172A" DockPanel.Dock="Top" Margin="0,0,0,12" />
                                <DataGrid ItemsSource="{Binding HourlyThroughput}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          GridLinesVisibility="Horizontal"
                                          HorizontalGridLinesBrush="#F1F5F9"
                                          BorderThickness="0"
                                          RowHeight="26"
                                          Background="Transparent">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Hour" Binding="{Binding HourLabel}" Width="100" />
                                        <DataGridTextColumn Header="Inspected" Binding="{Binding InspectedCount}" Width="110" />
                                        <DataGridTextColumn Header="Pass" Binding="{Binding PassCount}" Width="110" />
                                        <DataGridTextColumn Header="Rework" Binding="{Binding ReworkCount}" Width="110" />
                                        <DataGridTextColumn Header="Scrap" Binding="{Binding ScrapCount}" Width="110" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- Screen 4: Ask (P2) -->
            <TabItem Header="4. Ask (NL → SQL)">
                <Grid Margin="24">
                    <TextBlock Text="Guarded Natural-Language History Query (Ready for Milestone D13–14)"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#334155" />
                </Grid>
            </TabItem>

            <!-- Screen 5: Settings (F7) -->
            <TabItem Header="5. Settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
                    <StackPanel MaxWidth="680" HorizontalAlignment="Left" DataContext="{Binding Settings}">
                        <TextBlock Text="Station &amp; Backend Settings (F7)"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"
                                   Margin="0,0,0,16" />

                        <!-- API Settings -->
                        <TextBlock Text="DeepPCB-AOI API Connection"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#334155"
                                   Margin="0,8,0,8" />

                        <TextBlock Text="API Base URL" Margin="0,4,0,2" />
                        <TextBox Text="{Binding BaseUrl, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8,6"
                                 Margin="0,0,0,8" />

                        <TextBlock Text="Request Timeout (seconds, 1–300)" Margin="0,4,0,2" />
                        <TextBox Text="{Binding TimeoutSeconds, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8,6"
                                 Margin="0,0,0,12" />

                        <!-- Batch & Inspection Defaults -->
                        <TextBlock Text="Inspection &amp; Batch Defaults"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#334155"
                                   Margin="0,8,0,8" />

                        <TextBlock Text="Batch Concurrency (1–8)" Margin="0,4,0,2" />
                        <TextBox Text="{Binding Concurrency, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8,6"
                                 Margin="0,0,0,8" />

                        <TextBlock Text="Default IPC-A-600 Class" Margin="0,4,0,2" />
                        <ComboBox ItemsSource="{Binding AvailableIpcClasses}"
                                  SelectedItem="{Binding DefaultIpcClass}"
                                  Padding="8,6"
                                  Margin="0,0,0,8" />

                        <TextBlock Text="Default Batch ID" Margin="0,4,0,2" />
                        <TextBox Text="{Binding DefaultBatchId, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8,6"
                                 Margin="0,0,0,8" />

                        <CheckBox Content="Render industrial green solder-mask &amp; copper trace visuals (colorize_pcb)"
                                  IsChecked="{Binding ColorizePcb}"
                                  Margin="0,4,0,16" />

                        <!-- LLM Configuration -->
                        <TextBlock Text="LLM Explanation &amp; Query Settings (Verdicts Remain Rule-Based)"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#334155"
                                   Margin="0,8,0,8" />

                        <TextBlock Text="LLM Provider (API keys read from GEMINI_API_KEY / OPENAI_API_KEY env vars only)" Margin="0,4,0,2" />
                        <ComboBox ItemsSource="{Binding AvailableLlmProviders}"
                                  SelectedItem="{Binding LlmProvider}"
                                  Padding="8,6"
                                  Margin="0,0,0,8" />

                        <TextBlock Text="Model Name" Margin="0,4,0,2" />
                        <TextBox Text="{Binding ModelName, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8,6"
                                 Margin="0,0,0,8" />

                        <TextBlock Text="Summary Language" Margin="0,4,0,2" />
                        <ComboBox ItemsSource="{Binding AvailableSummaryLanguages}"
                                  SelectedItem="{Binding SummaryLanguage}"
                                  Padding="8,6"
                                  Margin="0,0,0,16" />

                        <!-- Actions -->
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,12">
                            <Button Content="Save Settings"
                                    Command="{Binding SaveSettingsCommand}"
                                    Padding="16,8"
                                    FontWeight="SemiBold"
                                    Background="#2563EB"
                                    Foreground="White"
                                    Margin="0,0,12,0" />

                            <Button Content="Check Backend Health"
                                    Command="{Binding CheckHealthNowCommand}"
                                    Padding="16,8" />
                        </StackPanel>

                        <TextBlock Text="{Binding StatusMessage}"
                                   FontWeight="SemiBold"
                                   Foreground="#0F172A"
                                   Margin="0,4,0,4" />

                        <TextBlock Text="{Binding HealthCheckResultText}"
                                   Foreground="#475569"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Bottom Status Bar (§7.5) -->
        <StatusBar Grid.Row="1"
                   Background="#0F172A"
                   Foreground="#F8FAFC"
                   Padding="12,6">
            <StatusBarItem>
                <Border Background="{Binding IsBackendOnline, Converter={StaticResource OnlineToStatusBrushConverter}}"
                        CornerRadius="10"
                        Padding="10,2"
                        ToolTip="{Binding BackendStatusTooltip}">
                    <TextBlock Text="{Binding BackendStatusText}"
                               Foreground="White"
                               FontWeight="SemiBold"
                               FontSize="12" />
                </Border>
            </StatusBarItem>

            <Separator Background="#334155" Margin="8,0" />

            <StatusBarItem>
                <TextBlock Text="{Binding DetectorAndVersionText}"
                           Foreground="#E2E8F0"
                           FontSize="12" />
            </StatusBarItem>

            <Separator Background="#334155" Margin="8,0" />

            <StatusBarItem>
                <TextBlock Text="{Binding DatabasePathText}"
                           Foreground="#94A3B8"
                           FontSize="12"
                           ToolTip="Local SQLite inspection history path" />
            </StatusBarItem>

            <Separator Background="#334155" Margin="8,0" />

            <StatusBarItem>
                <TextBlock Text="{Binding LlmProviderStatusText}"
                           Foreground="#E2E8F0"
                           FontSize="12" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
